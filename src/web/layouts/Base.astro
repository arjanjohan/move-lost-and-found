---
import { snapshot, STALE_AFTER_MS } from '../lib/data.ts';

interface Props { title: string; description?: string }
const { title, description = 'Find APT and MOVE you left behind: unstaked but never withdrawn, unstake requests never claimed, bridge transfers never collected, stakes in pools that ended.' } = Astro.props;
const path = Astro.url.pathname;
import { REPO } from '../lib/site.ts';
import Mark from '../components/Mark.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // A saved theme applies before the page draws; without one the device's setting does.
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <header class="topbar">
      <div class="wrap bar">
        <a href="/" class="brand" aria-label="Move Lost & Found, home">
          <Mark />Move Lost &amp; Found<span class="chains">Aptos · Movement</span>
        </a>
        <nav aria-label="Main">
          <a href="/#cases">What we find</a>
          <a href="/dashboard" aria-current={path.startsWith('/dashboard') ? 'page' : undefined}>Dashboard</a>
          <a href="/check" class="cta" aria-current={path.startsWith('/check') ? 'page' : undefined}>Check wallets</a>
        </nav>
      </div>
    </header>
    <div id="stale" class="wrap" hidden data-generated={snapshot?.generatedAt} data-limit={STALE_AFTER_MS}>
      <p class="banner">This data is older than a week. The weekly update may have failed; numbers can be out of date.</p>
    </div>
    <main class="wrap"><slot /></main>
    <footer class="foot">
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-about">
            <a href="/" class="brand"><Mark />Move Lost &amp; Found</a>
            <p>Read from the blockchains. Owners claim positions every day, so a result may already be claimed.</p>
          </div>
          <div>
            <h3>Product</h3>
            <a href="/check">Check wallets</a>
            <a href="/dashboard">Dashboard</a>
          </div>
          <div>
            <h3>The data</h3>
            <a href="/#cases">What we find</a>
            <a href="/how-we-count">How we count</a>
            <a href="/sources">Sources and evidence</a>
            <a href="/coverage">Protocol coverage</a>
          </div>
          <div>
            <h3>Help</h3>
            <a href="/#faq">Questions</a>
            <a href={`${REPO}/issues`}>Report a problem</a>
            <a href={REPO}>Source code</a>
          </div>
        </div>
        <div class="disclaimers">
          <div>
            <p>Read-only: we never ask for a seed phrase, a private key, a wallet connection or a signature.</p>
            <p>Not financial advice. Claim only through the official app or contract.</p>
          </div>
          <div class="theme-switch" role="group" aria-label="Theme">
            <button type="button" data-theme="light" aria-pressed="false" aria-label="Light" title="Light">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            </button>
            <button type="button" data-theme="dark" aria-pressed="false" aria-label="Dark" title="Dark">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z" /></svg>
            </button>
            <button type="button" data-theme="system" aria-pressed="true" aria-label="System" title="System">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
            </button>
          </div>
        </div>
      </div>
    </footer>
    <script>
      const el = document.getElementById('stale');
      const generated = el?.dataset.generated;
      if (el && (!generated || Date.now() - Date.parse(generated) > Number(el.dataset.limit))) el.hidden = false;

      // Theme: light or dark is saved in this browser; system removes the choice (the head script reads it).
      const themeButtons = document.querySelectorAll<HTMLButtonElement>('.theme-switch button');
      const showTheme = (t: string) => { for (const b of themeButtons) b.setAttribute('aria-pressed', String(b.dataset.theme === t)); };
      showTheme(document.documentElement.dataset.theme ?? 'system');
      for (const b of themeButtons) b.addEventListener('click', () => {
        const t = b.dataset.theme ?? 'system';
        if (t === 'system') delete document.documentElement.dataset.theme; else document.documentElement.dataset.theme = t;
        try { if (t === 'system') localStorage.removeItem('theme'); else localStorage.setItem('theme', t); } catch { /* kept for this visit only */ }
        showTheme(t);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf7; --fg: #1d1d1b; --muted: #6b6a66; --line: #e4e1da; --card: #ffffff; --soft: #f3f1ec;
    --accent: #1f6f5c; --accent-fg: #ffffff; --warn-bg: #fff4d6; --warn-fg: #6b4e00; --bad: #a33a2a;
    --c1: #1f6f5c; --c2: #d08a2c; --c3: #3b6fb6; --c4: #b5483a; --c5: #7a5bb3; --c6: #4c9a8a; --c7: #a6763c; --c8: #9a9890;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #141413; --fg: #ecebe6; --muted: #9b9a94; --line: #2c2b28; --card: #1c1b19; --soft: #22211e;
      --accent: #5fc2a6; --accent-fg: #10221d; --warn-bg: #3a2f10; --warn-fg: #f3d58a; --bad: #e07b6a;
      --c1: #5fc2a6; --c2: #e3a34c; --c3: #6f9fe0; --c4: #e07b6a; --c5: #a98be0; --c6: #7cc4b4; --c7: #c99a5e; --c8: #77756e;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #141413; --fg: #ecebe6; --muted: #9b9a94; --line: #2c2b28; --card: #1c1b19; --soft: #22211e;
    --accent: #5fc2a6; --accent-fg: #10221d; --warn-bg: #3a2f10; --warn-fg: #f3d58a; --bad: #e07b6a;
    --c1: #5fc2a6; --c2: #e3a34c; --c3: #6f9fe0; --c4: #e07b6a; --c5: #a98be0; --c6: #7cc4b4; --c7: #c99a5e; --c8: #77756e;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.55 system-ui, -apple-system, 'Segoe UI', sans-serif; }
  a { color: var(--accent); }
  .wrap { max-width: 1040px; margin: 0 auto; padding: 0 16px; }

  .topbar { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(10px); -webkit-backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid var(--line); }
  /* The nav wraps under the brand only when both do not fit on one line. */
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; min-height: 60px; padding-block: 8px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; letter-spacing: -0.01em; text-decoration: none; color: var(--fg); white-space: nowrap; }
  .chains { font-weight: 500; font-size: 12px; color: var(--muted); border: 1px solid var(--line); border-radius: 99px; padding: 2px 8px; }
  nav { display: flex; align-items: center; gap: 4px; }
  nav a { color: var(--muted); text-decoration: none; font-size: 15px; padding: 6px 10px; border-radius: 8px; white-space: nowrap; }
  nav a:hover, nav a[aria-current="page"] { color: var(--fg); background: var(--soft); }
  nav a.cta { color: var(--accent-fg); background: var(--accent); font-weight: 600; margin-left: 6px; }
  nav a.cta:hover { filter: brightness(1.08); background: var(--accent); color: var(--accent-fg); }
  @media (max-width: 640px) {
    .chains { display: none; }
    nav a:not(.cta) { padding: 6px 6px; font-size: 14px; }
  }
  @media (max-width: 400px) {
    nav a[href="/#cases"] { display: none; }
    .bar { column-gap: 8px; }
    .brand { gap: 8px; }
    nav a:not(.cta) { padding: 6px 4px; }
    nav a.cta { font-size: 14px; padding: 6px 10px; margin-left: 2px; }
  }

  .banner { background: var(--warn-bg); color: var(--warn-fg); padding: 10px 16px; border-radius: 8px; margin: 16px 0 0; }

  .foot { border-top: 1px solid var(--line); margin-top: 80px; padding: 40px 0 48px; color: var(--muted); font-size: 14px; }
  .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 24px; }
  .foot-grid h3 { font-size: 13px; font-weight: 600; color: var(--fg); margin: 0 0 10px; }
  .foot-grid > div > a:not(.brand) { display: block; color: var(--muted); text-decoration: none; margin: 6px 0; }
  .foot-grid > div > a:not(.brand):hover { color: var(--fg); }
  .foot-about p { max-width: 34ch; margin: 12px 0 0; }
  .disclaimers { border-top: 1px solid var(--line); margin-top: 32px; padding-top: 16px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 12px 24px; }
  .theme-switch { display: inline-flex; background: var(--soft); border: 1px solid var(--line); border-radius: 10px; padding: 3px; }
  .theme-switch button { display: grid; place-items: center; border: 0; background: transparent; color: var(--muted); padding: 5px 9px; border-radius: 8px; cursor: pointer; }
  .theme-switch button:hover { color: var(--fg); }
  .theme-switch button[aria-pressed="true"] { background: var(--card); color: var(--fg); box-shadow: 0 1px 2px rgb(0 0 0 / 0.08); }
  .theme-switch svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .disclaimers p { margin: 4px 0; }
  @media (max-width: 720px) { .foot-grid { grid-template-columns: 1fr 1fr; } .foot-about { grid-column: 1 / -1; } }

  h1 { font-size: clamp(30px, 6vw, 48px); line-height: 1.1; letter-spacing: -0.02em; margin: 40px 0 12px; }
  h2 { font-size: 22px; letter-spacing: -0.01em; margin: 56px 0 14px; }
  .muted { color: var(--muted); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; }
  .card b { display: block; font-size: 22px; }
  .table { width: 100%; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 15px; }
  th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 500; font-size: 13px; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .badge { display: inline-block; font-size: 12px; padding: 1px 8px; border-radius: 99px; border: 1px solid var(--line); color: var(--muted); }
  .badge.degraded { background: var(--warn-bg); color: var(--warn-fg); border-color: transparent; }
  .button { display: inline-block; background: var(--accent); color: var(--accent-fg); padding: 11px 20px; border-radius: 10px; text-decoration: none; font: inherit; font-weight: 600; border: 0; cursor: pointer; }
  .button.ghost { background: transparent; color: var(--fg); border: 1px solid var(--line); }
  .button.ghost:hover { background: var(--soft); }
  button.link { background: none; border: 0; padding: 0; font: inherit; color: var(--accent); text-decoration: underline; cursor: pointer; }
  code { font-size: 13px; overflow-wrap: anywhere; }

  /* Rendered markdown (docs pages). */
  /* Text keeps a readable measure; tables may use the full width. */
  .prose > :not(table, .table, .doc) { max-width: 780px; }
  .prose h2 { margin: 44px 0 10px; scroll-margin-top: 76px; }
  .prose h3 { font-size: 17px; margin: 28px 0 8px; scroll-margin-top: 76px; }
  .prose ul, .prose ol { padding-left: 22px; }
  .prose li { margin: 4px 0; }
  .prose li > ul { margin: 4px 0; }
  .prose table { display: block; overflow-x: auto; margin: 12px 0; }
  .prose code { background: var(--soft); padding: 1px 5px; border-radius: 5px; }
  .prose td code, .prose th code { white-space: nowrap; overflow-wrap: normal; }
  .prose blockquote { border-left: 3px solid var(--line); margin: 12px 0; padding-left: 14px; color: var(--muted); }
  .prose .source-note { margin-top: 48px; font-size: 14px; }
  .prose .doc > :not(table) { max-width: 780px; }
</style>
